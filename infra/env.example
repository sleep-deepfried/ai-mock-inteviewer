# Vocis Environment Variables
# ============================
#
# 1. Copy this file to /opt/vocis/.env on the EC2 instance
# 2. Fill in actual values for each variable below
# 3. Set permissions:
#      chmod 600 /opt/vocis/.env
#      chown vocis:vocis /opt/vocis/.env
#
# WARNING: Never commit real secrets to source control.
# HOSTNAME and PORT are set in the systemd unit — do not add them here.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Google Sheets spreadsheet ID (from the sheet URL)
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# GCP service account credentials JSON (single line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Google Sheets tab name for review logging
GOOGLE_SHEETS_TAB_NAME=Reviews

# Application stage
NEXT_PUBLIC_APP_STAGE=production
